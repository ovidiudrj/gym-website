@model IEnumerable<GymWebApp.Models.FitnessClass>

@{
    ViewData["Title"] = "Our classes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Our Fitness Classes</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">+ Add Class</a>
    }
</div>
<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Duration)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Capacity)
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.Trainer)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Duration) minutes
            </td>
            <td>
                @Html.DisplayFor(model => item.Capacity)
            </td>
            
            <td>
                @Html.DisplayFor(model => item.Trainer!.FullName)
            </td>
                <td class="text-end text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    }
                </td>
        </tr>
}
    </tbody>
</table>
