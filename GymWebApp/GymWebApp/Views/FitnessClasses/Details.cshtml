@model GymWebApp.Models.FitnessClass

@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@Model.Name</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Duration)</dt>
            <dd class="col-sm-10">@Model.Duration minutes</dd>

            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Capacity)</dt>
            <dd class="col-sm-10">@Model.Capacity</dd>

            <dt class="col-sm-2">Trainer</dt>
            <dd class="col-sm-10">@Model.Trainer?.FullName</dd>
        </dl>
    </div>
</div>

@if (User.IsInRole("Admin"))
{
    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
    </div>
}